# Copy to .env and replace every placeholder. Never commit real credentials.
DM_ENVIRONMENT=development
# Development placeholders shared with compose.yaml; replace outside disposable local use.
POSTGRES_DB=dm_assistant
POSTGRES_USER=dm_assistant
POSTGRES_PASSWORD=replace-development-database-password
POSTGRES_PORT=5432
DM_DATABASE_URL=postgresql+psycopg://dm_assistant:replace-development-database-password@postgres:5432/dm_assistant
DM_LOG_LEVEL=INFO
DM_SOURCE_ROOTS=["/data/campaign","/data/rules"]
DM_ASSET_ROOT=/data/assets
DM_SCRATCH_ROOT=/data/scratch
DM_API_TOKEN=replace-with-at-least-32-random-characters
DM_SESSION_SECRET=replace-with-a-different-32-character-secret

# Chat-model transport is a separate private process. No provider credentials belong here.
DM_MODEL_GATEWAY_POLICY=disabled
# DM_MODEL_GATEWAY_URL=http://model-gateway:3000

# Embeddings are independent of chat-model/Codex OAuth credentials.
DM_EMBEDDING_RUNTIME=disabled
DM_EMBEDDING_PROVIDER_POLICY=disabled
# Hosted embeddings require their own key and explicit provider-retention acknowledgement.
# DM_EMBEDDING_API_KEY=replace-with-hosted-embedding-provider-key
# DM_EMBEDDING_HOSTED_RETENTION_APPROVED=false
